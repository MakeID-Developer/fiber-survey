<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:padding="14dp" android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/tv_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textStyle="bold" android:textSize="17sp" android:textColor="@color/xc_heading" />
    <TextView android:id="@+id/tv_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" />
    <TextView android:id="@+id/tv_rssi" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" />
</LinearLayout>
